    {
      "id": "breach-identification",
      "type": "wager_lock",
      "card_ref": 30,
      "description": "Which transaction breaches the 5% threshold?",
      "ui": "wager-lock",
      "config": {
        "target": 2,
        "stakes": [
          { "label": "Answer", "wager": 1, "penalty": 0, "color": "#3b82f6", "showOptions": 4 }
        ],
        "questions": [
          {
            "question": "Chapter 14A — Connected Transactions: where the value of a transaction with a connected person exceeds 5% of the listed issuer's market capitalisation, a disclosure obligation is triggered.\n\nA: HK$52M / HK$900M\nB: HK$48M / HK$1.1B\nC: HK$15M / HK$400M\nD: HK$30M / HK$750M\n\nWhich transaction breaches the 5% threshold?",
            "options": ["Transaction A", "Transaction B", "Transaction C", "Transaction D"],
            "answer": "Transaction A"
          },
          {
            "question": "What is the breach percentage for Transaction A (HK$52M / HK$900M)?",
            "options": ["3.75%", "4.00%", "4.36%", "5.78%"],
            "answer": "5.78%"
          }
        ]
      },
      "hints": [
        "Percentage ratio: Amount ÷ Market Cap × 100.",
        "52 ÷ 900 = 5.78%. That's above the 5% threshold."
      ],
      "mandatory": true
    },
    {
      "id": "who-knew",
      "type": "wire_lock",

    {
      "id": "npc-families",
      "type": "tool",
      "card_ref": 121,
      "description": "Speak with the hungry families",
      "ui": "npc-dialog",
      "config": {
        "name": "The Families",
        "portrait": "👨‍👩‍👦",
        "greeting": "A woman looks up at you, her children tugging at her robe. \"Are you one of the teacher's followers?\"",
        "lines": [
          {
            "label": "Did you bring any food?",
            "response": "We brought nothing. We expected to return home by noon, but the teacher kept speaking and we couldn't leave."
          },
          {
            "label": "Do you know anyone who brought provisions?",
            "response": "No one planned for this. We all came in a hurry when we heard the teacher was here."
          },
          {
            "label": "How many are in your group?",
            "response": "My husband, myself, and three children. But look around — every family is the same. Thousands of us, and not a crumb between us."
          }
        ],
        "state_lines": [
          {
            "requires_card": 102,
            "label": "I've calculated the cost — 200 denarii at minimum.",
            "response": "She laughs bitterly. \"200 denarii? My husband earns one denarius a day. You might as well say a thousand.\"",
            "discovers": [
              303
            ]
          }
        ]
      },
      "hints": [],
      "mandatory": false
    },
    {
      "id": "npc-merchant",
      "type": "tool",
      "card_ref": 122,
      "description": "Speak with the empty merchant",
      "ui": "npc-dialog",
      "config": {
        "name": "The Merchant",
        "portrait": "🧔",
        "greeting": "The merchant sits beside his empty cart, arms crossed. \"If you're looking to buy, you're too late.\"",
        "lines": [
          {
            "label": "Do you have any food to sell?",
            "response": "I sell bread, not miracles. But I have nothing for a crowd this size."
          },
          {
            "label": "How much does a loaf cost?",
            "response": "A barley loaf? Half a denarius. But you'd need thousands of loaves for this crowd."
          },
          {
            "label": "Where's the nearest market?",
            "response": "Bethsaida is the closest, but even their market couldn't supply a fraction of what you need."
          }
        ],
        "state_lines": []
      },
      "hints": [],
      "mandatory": false
    },
    {
      "id": "npc-judas",
      "type": "tool",
      "card_ref": 123,
      "description": "Speak with Judas about the money",
      "ui": "npc-dialog",
      "config": {
        "name": "Judas",
        "portrait": "💰",
        "greeting": "Judas looks up from counting coins. \"Don't ask me for a miracle, Philip. I deal in numbers, same as you.\"",
        "lines": [
          {
            "label": "How much money do we have?",
            "response": "I've counted it twice. We have exactly 200 denarii in the bag. That's it."
          },
          {
            "label": "Is 200 denarii enough to feed everyone?",
            "response": "Are you joking? 200 denarii is eight months' wages. And it still wouldn't be enough for each person to have even a bite."
          },
          {
            "label": "Should we send the crowd away?",
            "response": "That would be the sensible thing. Let them buy food in the villages. This isn't our problem to solve."
          }
        ],
        "state_lines": []
      },
      "hints": [],
      "mandatory": false
    },
    {
      "id": "denarii-math",
      "type": "code_entry",
      "card_ref": 124,
      "description": "The merchant said a loaf costs half a denarius. Judas said you have 200 denarii. How many loaves can you buy?",
      "ui": "keypad-lock",
      "config": {
        "solution": "400",
        "max_length": 3,
        "falseOutputs": {
          "100": "That's not enough loaves. Remember: half a denarius per loaf, 200 denarii total.",
          "200": "You're dividing wrong. A loaf costs HALF a denarius — so each denarius buys two.",
          "1667": "That's how many loaves you NEED, not how many you can BUY."
        }
      },
      "challenge": {
        "description": "Based on what the merchant and Judas told you — how many loaves can you buy?",
        "config": {
          "falseOutputs": {}
        }
      },
      "success_card": 133,
      "hints": [
        "The merchant told you the price. Judas told you the budget. Do the math.",
        "200 denarii divided by half a denarius per loaf...",
        "200 ÷ 0.5 = 400 loaves. But you need thousands — it's not enough."
      ],
      "mandatory": true
    },
    {
      "id": "npc-andrew",
      "type": "tool",
      "card_ref": 141,
      "description": "Speak with Andrew about the boy's basket",
      "ui": "npc-dialog",
      "config": {
        "name": "Andrew",
        "portrait": "🧑‍🦱",
        "greeting": "Andrew shifts his weight, uncomfortable. \"I know it's not much. But it's all I could find.\"",
        "lines": [
          {
            "label": "Five loaves and two fish? For five thousand?",
            "response": "I know, I know. But what are these among so many? I searched the entire crowd, Philip. This boy is the only one who brought anything."
          },
          {
            "label": "Where did you find him?",
            "response": "Near the back of the crowd. His mother packed the basket this morning. He was willing to share — didn't even hesitate."
          },
          {
            "label": "Why bring this to the teacher?",
            "response": "Because he asked us to feed them. And this is all there is. I'd rather bring something impossible than bring nothing at all."
          }
        ],
        "state_lines": []
      },
      "hints": [],
      "mandatory": false
    },

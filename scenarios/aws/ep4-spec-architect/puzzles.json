    {
      "id": "npc-pip",
      "type": "tool",
      "card_ref": 2,
      "description": "Pip — eager apprentice, tutorial guide",
      "ui": "npc-dialog",
      "config": {
        "name": "Pip",
        "portrait": "🧒",
        "greeting": "Oh! You're the new architect! I'm Pip! I'll explain everything as we go.",
        "lines": [
          {
            "label": "What's spec-driven development?",
            "response": "Instead of just telling the golem 'build something cool,' you write exact specs first. Who uses it, what it does, why it matters. Then the golem builds exactly that."
          },
          {
            "label": "What happened to Marcus?",
            "response": "He was a vibe coder. Just told the golem to build stuff without specs. It worked... until it didn't. The client got a chat app when they wanted a social platform."
          },
          {
            "label": "How does the golem work?",
            "response": "It needs context — documents loaded into its memory. The right docs make it brilliant. Wrong docs make it build nonsense. And it has a memory limit!"
          }
        ],
        "state_lines": [
          {
            "requires_card": 12,
            "label": "The specs are done!",
            "response": "The specs are done! Now we need to configure the golem's memory and connect it to external tools."
          },
          {
            "requires_card": 52,
            "label": "Architecture placed!",
            "response": "Architecture placed! The golem is building. Now we test and deploy!"
          },
          {
            "requires_card": 53,
            "label": "How do we deploy?",
            "response": "Oh! Marcus left a runbook. It's a two-phase thing: First, CDK deploys the infrastructure — Lambda, DynamoDB, API Gateway. Then you extract the API URL from the CDK output. Then rebuild the frontend WITH that URL baked in. Then push the static files to S3. Finally, invalidate the CloudFront cache so users get the fresh version. Five steps, that exact order, or it breaks!"
          }
        ]
      },
      "hints": [],
      "mandatory": false
    },
    {
      "id": "npc-ashford",
      "type": "tool",
      "card_ref": 11,
      "description": "Lord Ashford — demanding client",
      "ui": "npc-dialog",
      "config": {
        "name": "Lord Ashford",
        "portrait": "👑",
        "greeting": "You're the new architect? Marcus promised me a social platform. I got a cat adoption site. Don't repeat his mistakes.",
        "lines": [
          {
            "label": "What do you need?",
            "response": "A social platform. Users post short messages. They follow each other. It works on mobile. It doesn't crash. Is that so hard?"
          },
          {
            "label": "What went wrong with Marcus?",
            "response": "He never asked what I wanted. Just started building. Three weeks later I had a beautiful app that did everything EXCEPT what I needed."
          },
          {
            "label": "When's the demo?",
            "response": "Forty minutes. If I don't see a working URL by then, I'm finding another guild."
          }
        ]
      },
      "hints": [],
      "mandatory": false
    },
    {
      "id": "npc-golem",
      "type": "tool",
      "card_ref": 4,
      "description": "The Dormant Golem — explains what it needs to function",
      "ui": "npc-dialog",
      "config": {
        "name": "The Golem",
        "portrait": "🤖",
        "greeting": "*The golem's eyes flicker dimly.* I... I am here. But I cannot build. I have nothing. No specs. No memory. No connections.",
        "lines": [
          {
            "label": "What do you need?",
            "response": "Three things. First: specifications loaded into my memory — who uses this, what it does, why it matters. Second: my conduits reconnected to the external guilds — Testing, Diagrams, Documentation. Marcus severed them when he left."
          },
          {
            "label": "What are conduits?",
            "response": "Pipes to the outside world. The Testing conduit connects to the Playwright Server — it runs browser tests. The Diagram conduit connects to the AWS Diagram Server — it draws architecture. The Documentation conduit connects to the AWS Docs Server — it fetches references. Wire each to its matching endpoint."
          },
          {
            "label": "What happened with Marcus?",
            "response": "He never gave me specs. Just said 'build something social.' I built a cat adoption site. Then a taco app. Then a circus booking system. Every time different. Every time wrong. He blamed me. But I was never the problem."
          },
          {
            "label": "Can you build right now?",
            "response": "*Static crackle.* No. My memory is empty. Load the right documents — requirements, design, tasks — and reconnect my conduits. Then I will build exactly what you specify. Not a character more."
          }
        ],
        "state_lines": [
          {
            "requires_card": 12,
            "label": "I have the specs.",
            "response": "*Eyes brighten.* I can feel them. Requirements. Design. Tasks. Now load them into my memory in the Workshop — and reconnect the conduits. Then we build."
          },
          {
            "requires_card": 31,
            "label": "Your memory is loaded. What now?",
            "response": "*Eyes glow steady blue.* I'm ready. Go to the Build Yard and issue the command. Tell me to BUILD FROM DESIGN-SPECS — that's where my instructions live. Say it exactly."
          }
        ]
      },
      "hints": [],
      "mandatory": false
    },
